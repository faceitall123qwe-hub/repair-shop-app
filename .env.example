# Skopiuj do .env.local i uzupełnij. Plik .env.local jest w .gitignore.

# ── Baza danych (Supabase Postgres) ──
# Supabase → Project → Connect. Do runtime użyj "Transaction pooler" (port 6543),
# do migracji (drizzle-kit) "Session pooler" lub "Direct" (port 5432) jako DIRECT_URL.
DATABASE_URL="postgresql://postgres.REF:HASLO@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.REF:HASLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Aplikacja ──
NEXT_PUBLIC_SITE_URL="https://serwispodreka.pl"

# ── Obszar obsługi (haversine od bazy) ──
# Baza: Białołęka, Warszawa
BASE_LAT="52.321"
BASE_LNG="20.9876"
SERVICE_RADIUS_KM="50"

# ── Sesje admina / bezpieczeństwo ──
SESSION_SECRET=""          # openssl rand -base64 32
IP_HASH_SALT=""            # openssl rand -base64 32 — sól do SHA-256(ip); surowe IP nigdy nie trafia do bazy
ADMIN_EMAIL=""             # login pierwszego admina
ADMIN_PASSWORD=""          # hasło tylko do seeda pierwszego konta

# ── E-mail (Resend) — Faza 4 ──
RESEND_API_KEY=""
EMAIL_FROM="SerwisPod Ręką <noreply@serwispodreka.pl>"

# ── Telegram Bot API — Faza 4 ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""        # ID czatu admina
TELEGRAM_WEBHOOK_SECRET="" # nagłówek X-Telegram-Bot-Api-Secret-Token

# ── Cloudflare Turnstile — Faza 2 ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Vercel Blob (zdjęcia sprzętu) — Faza 2/3 ──
BLOB_READ_WRITE_TOKEN=""

# ── Cron (Vercel) ──
CRON_SECRET=""             # weryfikacja wywołań /api/cron/*
